# --- Runtime ---
NODE_ENV=development
PORT=4101
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (placeholder for Session 2) ---
# VAULT_DB_URI=postgres://vault:vault@localhost:5432/aadhaar_vault

# --- Key provider (placeholder for Session 3) ---
# KEY_PROVIDER=local-dev
# LOCAL_DEV_MASTER_KEY=change-me-32-bytes-base64-changeme
# KEY_VERSION=kv-1

# --- Service JWT (placeholder for Session 4) ---
# SERVICE_JWT_AUDIENCE=fln-vault
# SERVICE_JWT_ISSUER=https://fln-backend.example.invalid
# FLN_BACKEND_JWKS_URL=https://fln-backend.example.invalid/.well-known/jwks.json

# --- Safety guard (per AADHAAR_VAULT_FREE_ARCHITECTURE.md §5.1) ---
# When NODE_ENV=production, the Vault refuses to start with KEY_PROVIDER=local-dev
# unless this is explicitly set to true. Required to avoid silent key leaks.
# VAULT_ALLOW_UNSAFE_KEY_PROVIDER=false